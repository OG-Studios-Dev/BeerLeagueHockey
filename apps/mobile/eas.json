{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": false,
        "image": "macos-tahoe-26.5-xcode-26.6"
      }
    },
    "preview": {
      "distribution": "internal",
      "ios": {
        "simulator": false,
        "image": "macos-tahoe-26.5-xcode-26.6",
        "buildConfiguration": "Release"
      }
    },
    "ios-simulator": {
      "developmentClient": false,
      "distribution": "internal",
      "environment": "production",
      "ios": {
        "simulator": true,
        "image": "macos-tahoe-26.5-xcode-26.6",
        "buildConfiguration": "Release"
      }
    },
    "production": {
      "distribution": "store",
      "environment": "production",
      "autoIncrement": true,
      "ios": {
        "simulator": false,
        "image": "macos-tahoe-26.5-xcode-26.6",
        "buildConfiguration": "Release"
      },
      "android": {
        "buildType": "apk"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleId": "nick@bridg3.io",
        "ascAppId": "6759818670",
        "appleTeamId": "C88U8Q3SMR"
      }
    }
  }
}
