{
  "expo": {
    "name": "Hockey Life",
    "slug": "beer-league-hockey",
    "version": "1.0.0",
    "scheme": "blh",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#111717"
    },
    "plugins": [
      "expo-apple-authentication",
      "expo-asset",
      "expo-secure-store",
      "expo-web-browser",
      "expo-image-picker",
      "expo-notifications",
      "expo-font"
    ],
    "ios": {
      "bundleIdentifier": "ca.beerleaguehockey.app",
      "buildNumber": "28",
      "supportsTablet": false,
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocationWhenInUseUsageDescription": "Hockey Life uses your location to find nearby hockey leagues.",
        "NSCalendarsUsageDescription": "Hockey Life adds your hockey games to your calendar.",
        "NSPhotoLibraryUsageDescription": "Hockey Life needs photo access to update your profile picture.",
        "NSCameraUsageDescription": "Hockey Life needs camera access to take a profile photo.",
        "UIBackgroundModes": [
          "remote-notification"
        ]
      }
    },
    "android": {
      "package": "ca.beerleaguehockey.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#111717"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "extra": {
      "eas": {
        "projectId": "ed35ed7d-c5a3-415c-a7d1-ee0366a77dc3"
      }
    },
    "owner": "nickgrossi"
  }
}
