{
  "expo": {
    "name": "Hockey Life",
    "slug": "beer-league-hockey",
    "version": "1.0.0",
    "scheme": "blh",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#111717"
    },
    "plugins": [
      "expo-apple-authentication",
      "expo-asset",
      "expo-secure-store",
      "expo-web-browser",
      "expo-notifications",
      [
        "expo-calendar",
        {
          "calendarPermission": "Hockey Life adds your hockey games to your calendar.",
          "remindersPermission": false
        }
      ],
      "expo-font"
    ],
    "ios": {
      "bundleIdentifier": "ca.beerleaguehockey.app",
      "buildNumber": "29",
      "supportsTablet": false,
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCalendarsUsageDescription": "Hockey Life adds your hockey games to your calendar.",
        "UIBackgroundModes": [
          "remote-notification"
        ]
      }
    },
    "android": {
      "package": "ca.beerleaguehockey.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#111717"
      },
      "permissions": [],
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "extra": {
      "eas": {
        "projectId": "ed35ed7d-c5a3-415c-a7d1-ee0366a77dc3"
      }
    },
    "owner": "nickgrossi"
  }
}
