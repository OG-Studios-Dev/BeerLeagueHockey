{
  "name": "hockey-life-monorepo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "dev:builder": "turbo dev --filter=@hockey-life/league-builder",
    "dev:website": "turbo dev --filter=@hockey-life/league-sites",
    "dev:mobile": "cd apps/mobile && npx expo start",
    "build": "turbo build",
    "lint": "turbo lint",
    "test": "jest --config jest.config.cjs",
    "test:watch": "jest --config jest.config.cjs --watch",
    "type-check": "turbo type-check",
    "audit:tenant-queries": "tsx scripts/platform/audit-tenant-query-scoping.ts",
    "verify:legacy-baseline-stats": "node scripts/verify-legacy-baseline-stats.ts",
    "audit:content-health": "tsx scripts/platform/check-content-health.ts",
    "audit:idempotency": "tsx scripts/platform/audit-idempotency-usage.ts",
    "audit:stripe-pricing": "tsx scripts/platform/validate-stripe-pricing.ts",
    "release:readiness": "tsx scripts/platform/release-readiness.ts",
    "audit:platform": "pnpm audit:tenant-queries && pnpm audit:idempotency && pnpm audit:stripe-pricing && pnpm release:readiness",
    "clean": "turbo clean && rm -rf node_modules",
    "knip": "knip"
  },
  "dependencies": {
    "@ducanh2912/next-pwa": "^10.2.9",
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@stripe/connect-js": "^3.3.33",
    "@stripe/stripe-js": "^8.6.1",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.90.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "framer-motion": "^12.29.2",
    "html-escaper": "^3.0.3",
    "lucide-react": "^0.562.0",
    "motion": "^12.29.2",
    "next": "16.2.6",
    "next-themes": "^0.4.6",
    "node-html-parser": "^7.0.2",
    "openai": "^6.16.0",
    "pg": "^8.17.2",
    "postgres": "^3.4.8",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.71.0",
    "react-use-measure": "^2.1.7",
    "resend": "^6.8.0",
    "sonner": "^2.0.7",
    "stripe": "^20.1.2",
    "tailwind-merge": "^3.4.0",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.5",
    "jest": "^29.7.0",
    "knip": "^5.83.1",
    "tailwindcss": "^4",
    "ts-jest": "^29.1.2",
    "tsx": "^4.19.2",
    "turbo": "^2.8.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5"
  },
  "packageManager": "pnpm@9.0.0",
  "pnpm": {
    "overrides": {
      "next@>=15.6.0-canary.0 <16.1.5": ">=16.1.5",
      "next@>=16.1.0-canary.0 <16.1.5": ">=16.1.5",
      "next@>=16.0.0-beta.0 <16.1.5": ">=16.1.5",
      "serialize-javascript": ">=7.0.3",
      "minimatch": "10.2.3",
      "tar": "7.5.11",
      "rollup": ">=4.59.0",
      "ajv": "8.18.0",
      "eslint>ajv": "6.14.0",
      "@eslint/eslintrc>ajv": "6.14.0",
      "dompurify": "3.3.2",
      "mailparser": "3.9.3",
      "bn.js": ">=4.12.3"
    }
  }
}
