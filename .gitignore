# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
.next/
/out/

# production
/build

# turbo
.turbo/

# worktrees
hockey-life-worktrees/

# misc
.DS_Store
*.pem
*.p8
*.key
nul

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# PWA (auto-generated by workbox / serwist)
**/public/workbox-*.js
**/public/workbox-*.js.map
**/public/sw.js
**/public/sw.js.map
**/public/swe-worker-*.js
**/public/swe-worker-*.js.map

# Electron build artifacts
tools/orchestrator/dist/
*.exe

# E2E auth state (contains session tokens)
e2e/**/.auth/
**/playwright-report/

# Installed skills (local only)
.agents/
.claude/skills/
**/.claude/settings.local.json

# Subdir .claude shims (symlinks for hook cwd compatibility)
apps/**/.claude/

# MCP config (contains access tokens)
.mcp.json

# Supabase temp
supabase/.temp/
.tmp/
apps/remotion/build/

# Native iOS generated artifacts
/apps/ios/*.xcodeproj
/apps/ios/.derived-data/
/apps/ios/.artifacts/

# Local agent-workspace files and data-export artifacts (not app code — keep local, don't commit)
/.openclaw/
/artifacts/
/tmp/
/AGENTS.md
/HEARTBEAT.md
/IDENTITY.md
/SOUL.md
/TOOLS.md
/USER.md
