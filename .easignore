# EAS CLI 24 reads this file at EAS_PROJECT_ROOT instead of ALL .gitignore files.
# Preserve the root rules verbatim and scoped nested rules below when updating ignores.
# Use EAS_NO_VCS=1: ignore rules do not sanitize a Git-mode archive's Git objects.

# --- Existing root .gitignore (verbatim) ---
# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
.next/
/out/

# production
/build

# turbo
.turbo/

# worktrees
hockey-life-worktrees/

# misc
.DS_Store
*.pem
*.p8
*.key
nul

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# PWA (auto-generated by workbox / serwist)
**/public/workbox-*.js
**/public/workbox-*.js.map
**/public/sw.js
**/public/sw.js.map
**/public/swe-worker-*.js
**/public/swe-worker-*.js.map

# Electron build artifacts
tools/orchestrator/dist/
*.exe

# E2E auth state (contains session tokens)
e2e/**/.auth/
**/playwright-report/

# Installed skills (local only)
.agents/
.claude/skills/

# Subdir .claude shims (symlinks for hook cwd compatibility)
apps/**/.claude/

# MCP config (contains access tokens)
.mcp.json

# Supabase temp
supabase/.temp/
.tmp/
apps/remotion/build/

# Native iOS generated artifacts
/apps/ios/*.xcodeproj
/apps/ios/.derived-data/
/apps/ios/.artifacts/

# Local agent-workspace files and data-export artifacts (not app code — keep local, don't commit)
/.openclaw/
/artifacts/
/tmp/
/AGENTS.md
/HEARTBEAT.md
/IDENTITY.md
/SOUL.md
/TOOLS.md
/USER.md

# --- Existing apps/league-sites/.gitignore (scoped to repository root) ---
# Dependencies
/apps/league-sites/**/node_modules/
/apps/league-sites/**/.pnpm-store/

# Build outputs
/apps/league-sites/**/.next/
/apps/league-sites/**/out/
/apps/league-sites/**/build/
/apps/league-sites/**/dist/

# Cache
/apps/league-sites/**/.turbo/
/apps/league-sites/**/*.tsbuildinfo

# Environment
/apps/league-sites/**/.env
/apps/league-sites/**/.env.local
/apps/league-sites/**/.env.development.local
/apps/league-sites/**/.env.test.local
/apps/league-sites/**/.env.production.local

# Editor
/apps/league-sites/**/.idea/
/apps/league-sites/**/.vscode/
/apps/league-sites/**/*.swp
/apps/league-sites/**/*.swo

# OS
/apps/league-sites/**/.DS_Store
/apps/league-sites/**/Thumbs.db

# Debug
/apps/league-sites/**/npm-debug.log*
/apps/league-sites/**/yarn-debug.log*
/apps/league-sites/**/yarn-error.log*

# Vercel
/apps/league-sites/**/.vercel/

# --- Existing apps/mobile/.gitignore (scoped to repository root) ---
/apps/mobile/**/node_modules/
/apps/mobile/**/.expo/
/apps/mobile/**/.expo-shared/
/apps/mobile/**/web-build/
/apps/mobile/**/npm-debug.*
/apps/mobile/**/*.jks
/apps/mobile/**/*.p8
/apps/mobile/**/*.p12
/apps/mobile/**/*.key
/apps/mobile/**/*.mobileprovision
/apps/mobile/**/*.orig
/apps/mobile/**/.DS_Store
/apps/mobile/**/.env.local
/apps/mobile/**/.codex-monorepo-preview.png

# --- Existing supabase/.gitignore (scoped to repository root) ---
# Supabase
/supabase/**/.branches
/supabase/**/.temp

# dotenvx
/supabase/**/.env.keys
/supabase/**/.env.local
/supabase/**/.env.*.local

# Approved upload-only exclusions; do not remove these paths from Git history.
# No trailing slash: EAS fs.cp checks directories without one, including empty dirs.
/.claude/worktrees
/artifacts
/apps/mobile/ios
/apps/mobile/android
# Exclude Git metadata files/directories at any depth, including worktree .git files.
.git

# Approved upload-only exclusions for local agent runtime output and settings.
/.claude/orchestration.log
/.claude/settings.local.json
/.claude/work-logs
